{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Govio Relationship Definition",
  "description": "物理表关系定义文件 schema，用于校验 govio relationship JSON（表引用使用全限定标识 <datasource_name>.<schema>.<table>）",
  "type": "object",
  "required": ["version", "relationships"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/relationship"
      },
      "minItems": 1
    }
  },
  "definitions": {
    "table_ref": {
      "type": "object",
      "required": ["PhysicalTable", "Cols"],
      "additionalProperties": false,
      "properties": {
        "PhysicalTable": {
          "type": "string",
          "minLength": 1,
          "description": "全限定表标识 <datasource_name>.<schema>.<table>"
        },
        "Cols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "description": "关联列名列表（表内简单列名），支持复合键"
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["source", "target", "relationship_type"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/definitions/table_ref"
        },
        "target": {
          "$ref": "#/definitions/table_ref"
        },
        "relationship_type": {
          "type": "string",
          "enum": ["one_to_one", "one_to_many", "many_to_one", "many_to_many"]
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
